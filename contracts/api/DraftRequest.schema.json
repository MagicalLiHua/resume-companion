{
  "$defs": {
    "DraftConstraints": {
      "additionalProperties": false,
      "properties": {
        "language": {
          "const": "zh-CN",
          "title": "Language",
          "type": "string"
        },
        "tone": {
          "const": "professional_plain",
          "title": "Tone",
          "type": "string"
        },
        "max_characters": {
          "maximum": 1000,
          "minimum": 1,
          "title": "Max Characters",
          "type": "integer"
        }
      },
      "required": [
        "language",
        "tone",
        "max_characters"
      ],
      "title": "DraftConstraints",
      "type": "object"
    },
    "Fact": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9_-]{1,100}$",
          "title": "Id",
          "type": "string"
        },
        "text": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "id",
        "text"
      ],
      "title": "Fact",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "protocol_version": {
      "const": "1.0",
      "title": "Protocol Version",
      "type": "string"
    },
    "request_id": {
      "pattern": "^[A-Za-z0-9_-]{1,100}$",
      "title": "Request Id",
      "type": "string"
    },
    "question": {
      "maxLength": 1000,
      "minLength": 1,
      "title": "Question",
      "type": "string"
    },
    "job_requirements": {
      "items": {
        "maxLength": 300,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 10,
      "title": "Job Requirements",
      "type": "array"
    },
    "facts": {
      "items": {
        "$ref": "#/$defs/Fact"
      },
      "maxItems": 20,
      "title": "Facts",
      "type": "array"
    },
    "constraints": {
      "$ref": "#/$defs/DraftConstraints"
    }
  },
  "required": [
    "protocol_version",
    "request_id",
    "question",
    "job_requirements",
    "facts",
    "constraints"
  ],
  "title": "DraftRequest",
  "type": "object"
}
