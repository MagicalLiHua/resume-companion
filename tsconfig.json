{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "useUnknownInCatchVariables": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node", "chrome"]
  },
  "include": ["extension/src/**/*.ts", "native-host/src/**/*.ts", "shared/**/*.ts", "tests/browser/**/*.ts"]
}
