{
  "name": "applymcp-plugin",
  "version": "0.24.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run typecheck && npm run test:unit",
    "test:unit": "vitest run --exclude tests/stage0-direct-devtools.test.ts --exclude tests/runtime-recovery.browser.test.ts --exclude tests/recruitment-observation.browser.test.ts",
    "test:devtools": "vitest run --no-file-parallelism --maxWorkers=1 tests/stage0-direct-devtools.test.ts tests/runtime-recovery.browser.test.ts tests/recruitment-observation.browser.test.ts",
    "test:core": "node scripts/core-self-test.mjs",
    "test:clients": "node scripts/client-integrations-test.mjs",
    "config:agent": "node scripts/print-agent-config.mjs",
    "check": "npm test && npm run build && npm run test:clients && npm run test:core && npm run test:devtools",
    "test:controls": "node ../../tests/real-controls/run.mjs",
    "test:controls:build": "npm run build --prefix ../../tests/real-controls",
    "test:controls:baseline": "node ../../tests/real-controls/run.mjs --baseline",
    "test:controls:contracts": "node ../../tests/real-controls/contracts.mjs",
    "test:controls:dayee": "node ../../tests/real-controls/dayee-contracts.mjs",
    "test:controls:benchmark": "node ../../tests/real-controls/benchmark.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "chrome-devtools-mcp": "1.9.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}
