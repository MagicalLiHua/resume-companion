{
  "name": "resume-companion-codex-plugin",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run typecheck && vitest run && node scripts/self-test.mjs",
    "test:unit": "vitest run --exclude tests/devtools-live.test.ts",
    "test:devtools": "vitest run tests/devtools-live.test.ts",
    "test:live": "node scripts/live-extension-test.mjs",
    "test:core": "node scripts/core-self-test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "chrome-devtools-mcp": "1.9.0",
    "ws": "8.21.3",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "@types/ws": "8.18.1",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}
