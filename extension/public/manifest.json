{
  "manifest_version": 3,
  "name": "简历随行 · MCP 浏览器执行桥",
  "version": "0.7.0",
  "minimum_chrome_version": "116",
  "description": "通过本地 MCP 让 AI 观察并填写招聘网页；简历资料由 MCP 在本机管理。",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "action": {
    "default_title": "简历随行"
  },
  "background": {
    "service_worker": "background-0.7.0.js",
    "type": "module"
  },
  "options_page": "options.html",
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src https: ws://127.0.0.1:43117"
  },
  "key": ""
}
