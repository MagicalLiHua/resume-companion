{
  "manifest_version": 3,
  "name": "简历随行 · 可选扩展执行桥",
  "version": "0.8.0",
  "minimum_chrome_version": "116",
  "description": "Chrome DevTools 无法使用时，为简历随行 MCP 提供可选的网页执行回退。",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "action": {
    "default_title": "简历随行"
  },
  "background": {
    "service_worker": "background-0.8.0.js",
    "type": "module"
  },
  "options_page": "options.html",
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src https: ws://127.0.0.1:43117"
  },
  "key": ""
}
